@cli.cmd()
def dev__env__status(*args):
    """
    Check the status of the development environment using overmind status

    Example:
        task dev status
    """
    os.chdir(SCRIPT_DIR)

    # Check if overmind installed?
    try:
        subprocess.run([get_overmind_path(), "--version"], check=True, capture_output=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("Error: overmind is not installed. Please install overmind to use this command.")
        sys.exit(1)

    # Check if overmind is running by testing the socket
    result = subprocess.run([get_overmind_path(), "status"] + list(args),
                          capture_output=True, text=True)

    if result.returncode == 0:
        # Overmind is running, show the status
        print(result.stdout)
    else:
        # Overmind is not running
        print("Development environment is not running.")
        print("Start it with: ./task dev env start")

@cli.cmd()
def dev__env__logs(*args):
    """
    View the logs of the development environment

    By default, shows a tail of the log file. Use --follow to follow logs in real-time.

    Example:
        task dev logs
        task dev logs --follow
    """
    os.chdir(SCRIPT_DIR)

    # Check if --follow flag is present
    follow_mode = "--follow" in args
    filtered_args = [arg for arg in args if arg != "--follow"]

    if follow_mode:
        # Check if overmind installed?
        try:
            subprocess.run([get_overmind_path(), "--version"], check=True, capture_output=True)
        except (subprocess.CalledProcessError, FileNotFoundError):
            print("Error: overmind is not installed. Please install overmind to use this command.")
            sys.exit(1)

        # Run overmind echo to follow logs in real-time
        os.execve(get_overmind_path(), [get_overmind_path(), "echo"] + filtered_args, os.environ)
    else:
        # Show tail of log file
        log_file = Path("/tmp/mcpzoo-overmind.log")
        if log_file.exists():
            os.execve("/usr/bin/tail", ["/usr/bin/tail", "-n", "150", str(log_file)], os.environ)
        else:
            print(f"Log file not found: {log_file}")
            sys.exit(1)

