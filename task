@cli.cmd()
def dev__env__start(*args):
    """
    Start the development environment using the Procfile and overmind

    This is an idempotent command that can be run multiple times to ensure the
    development environment is up and running.

    By default, runs in the background (non-blocking). Use --no-daemon to run in foreground.

    Logs are written to /tmp/mcpzoo-overmind.log

    Example:
        task dev start
        task dev start --no-daemon
    """
    os.chdir(SCRIPT_DIR)

    # Check if overmind installed?
    try:
        subprocess.run([str(get_overmind_path()), "--version"], check=True, capture_output=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("Error: overmind is not installed. Please install overmind to use this command.")
        sys.exit(1)

    # Check if overmind is running?
    result = os.system("pgrep -f overmind > /dev/null 2>&1")
    if result == 0:
        print("Development environment is already running.")
        sys.exit(0)

    # Handle dangling overmind.sock
    overmind_sock = SCRIPT_DIR / ".overmind.sock"
    if overmind_sock.exists():
        overmind_sock.unlink()

    # Ensure logs directory exists
    logs_dir = SCRIPT_DIR / "logs"
    logs_dir.mkdir(exist_ok=True)
    log_file = Path("/tmp/mcpzoo-overmind.log")

    # Determine if daemon mode or not
    daemon_mode = True
    filtered_args = []
    for arg in args:
        if arg == "--no-daemon":
            daemon_mode = False
        else:
            filtered_args.append(arg)

    procfile = str(SCRIPT_DIR / "Procfile")
    if daemon_mode:
        # Start overmind as a background process with output redirected to log file
        cmd = [str(get_overmind_path()), "start", "--procfile", procfile] + filtered_args
        with open(log_file, 'w') as logfile:
            subprocess.Popen(cmd, stdout=logfile, stderr=logfile, cwd=SCRIPT_DIR)
        print(f"Development environment started. Logs: {log_file}")
    else:
        cmd = [get_overmind_path(), "start", "--procfile", procfile] + filtered_args
        os.execve(cmd[0], cmd, os.environ)

@cli.cmd()
def dev__env__stop(*args):
    """
    Stop the development environment by terminating the overmind process

    Example:
        task dev stop
    """
    os.chdir(SCRIPT_DIR)

    # Check if overmind installed?
    try:
        subprocess.run([get_overmind_path(), "--version"], check=True, capture_output=True)
    except (subprocess.CalledProcessError, FileNotFoundError):
        print("Error: overmind is not installed. Please install overmind to use this command.")
        sys.exit(1)

    # Run overmind quit
    os.execve(get_overmind_path(), [get_overmind_path(), "quit"] + list(args), os.environ)

