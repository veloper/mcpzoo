@lru_cache(maxsize=1)
def get_overmind_path() -> Path:
    """Get the path to the overmind executable."""
    possible_paths = [
        Path("/usr/local/bin/overmind"),
        Path("/usr/bin/overmind"),
        Path.home() / ".local" / "bin" / "overmind",
    ]
    for path in possible_paths:
        if path.exists() and os.access(path, os.X_OK):
            return path
    raise FileNotFoundError("overmind executable not found in standard locations.")

def get_docstring_from_function(func):
    """Extract the docstring from a function."""
    return func.__doc__ or "No documentation available."


# Decorator Class to register commands
@dataclass
class Cmd:
    func: Callable
    name: str|None = None
    namespace: str|None = None
    docstring: str|None = None

@dataclass
class CliDecorator:
    commands: list[Cmd]

    def cmd(self, func=None, *, name: str | None = None, namespace: str | None = None):
        def decorator(f):
            if name is None:
                func_name = f.__name__
                # Split on __ to create namespace hierarchy
                parts = func_name.split("__")
                if len(parts) >= 2:
                    # First part is namespace, remaining parts form command with spaces
                    inferred_namespace = parts[0]
                    inferred_name = " ".join(parts[1:]).replace("_", "-")
                else:
                    inferred_namespace = None
                    inferred_name = func_name.replace("_", "-")
                final_name = inferred_name
                final_namespace = namespace or inferred_namespace
            else:
                final_name = name
                final_namespace = namespace
            self.commands.append(Cmd(func=f, name=final_name, namespace=final_namespace, docstring=get_docstring_from_function(f)))
            return f
        if func is not None:
            return decorator(func)
        return decorator

    def run(self):
        if len(sys.argv) < 2:
            self._print_help()
            return
        namespace = sys.argv[1]
        remaining_args = sys.argv[2:]

        # Check if --help is requested at namespace level
        if remaining_args == ["--help"]:
            self._print_namespace_help(namespace)
            return

        # Find the longest matching command for this namespace
        matching_cmd = None
        command_args = []

        for cmd in self.commands:
            if cmd.namespace == namespace and cmd.name:
                cmd_parts = cmd.name.split()
                # Check if the command matches the prefix of remaining_args
                if len(remaining_args) >= len(cmd_parts):
                    if remaining_args[:len(cmd_parts)] == cmd_parts:
                        matching_cmd = cmd
                        command_args = remaining_args[len(cmd_parts):]
                        break

        if matching_cmd:
            # Check if --help is requested for this specific command
            if "--help" in command_args:
                self._print_command_help(matching_cmd)
                return
            matching_cmd.func(*command_args)
            return

        self._print_help()

    def _print_help(self):
        print("Available commands:")
        for cmd in self.commands:
            command = f"{cmd.name}"
            if cmd.namespace:
                command = f"{cmd.namespace} {command}"
            command = f"./{FILENAME} {command}"


            docstring = dedent(cmd.docstring or "").strip()
            docstring = "    "+docstring.replace("\n", "\n    ")

            print(f"\n{command}\n{docstring}")

    def _print_namespace_help(self, namespace):
        """Print help for all commands in a specific namespace."""
        namespace_commands = [cmd for cmd in self.commands if cmd.namespace == namespace]
        if not namespace_commands:
            print(f"No commands found for namespace '{namespace}'")
            return

        print(f"Available commands for '{namespace}' namespace:")
        for cmd in namespace_commands:
            command = f"./{FILENAME} {namespace} {cmd.name}"

            docstring = dedent(cmd.docstring or "").strip()
            docstring = "    "+docstring.replace("\n", "\n    ")

            print(f"\n{command}\n{docstring}")

    def _print_command_help(self, cmd):
        """Print help for a specific command."""
        command = f"./{FILENAME} {cmd.namespace} {cmd.name}" if cmd.namespace else f"./{FILENAME} {cmd.name}"

        docstring = dedent(cmd.docstring or "").strip()

        print(f"{command}\n\n{docstring}")
        
cli = CliDecorator(commands=[])
    
