@cli.cmd()
def prod__docker__build(*args):
    """
    Build production artifacts and Docker image for MCPZoo.

    This builds the frontend/dist and creates the production Docker image.

    Additional options are passed through to docker build.

    After building, run the container with:
        docker run -p 7998-8199:7998-8199 \\
            -e APP_USERNAME=admin -e APP_PASSWORD=changeme123 \\
            mcpzoo

    Access the application at: http://localhost:7999

    Example:
        task prod build
        task prod build --no-cache
    """
    # Build frontend for production
    os.chdir(FRONTEND_DIR)
    subprocess.run(["npm", "run", "build"], check=True)

    # Build backend for production
    os.chdir(BACKEND_DIR)
    subprocess.run(["uv", "sync", "--frozen"], check=True)

    # Build production Docker image
    os.chdir(SCRIPT_DIR)
    cmd = [
        "docker", "build",
        "-t", DOCKER_IMAGE_PROD,
        "-f", SCRIPT_DIR / DOCKER_FILE_PROD,
        ".",
    ] + list(args)
    subprocess.run(cmd, check=True)



