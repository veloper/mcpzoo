FROM python:3.10-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    git \
    build-essential \
    supervisor \
    nginx \
    nodejs \
    npm \
    parallel \
    tmux \
    && rm -rf /var/lib/apt/lists/*

# Install Mise early
RUN curl -L https://mise.jdx.dev/install.sh -o /tmp/mise-install.sh && sh /tmp/mise-install.sh

RUN ln -s /root/.local/bin/mise /usr/local/bin/mise

ENV PATH="/root/.local/bin:$PATH" \
    MISE_ACTIVATE_DIR=1

# Install Overmind
COPY docker/overmind-v2.5.1-linux-amd64.gz /tmp/overmind.gz
RUN gunzip /tmp/overmind.gz \
    && mv /tmp/overmind /usr/local/bin/overmind \
    && chmod +x /usr/local/bin/overmind

COPY backend/ /app/backend/
COPY frontend/ /app/frontend/

# Pre-install mise tools to cache them in the image
RUN mise install node@lts 
RUN mise install python@3.11
RUN mise install uv@latest
RUN mise use -g python && pip install --user pipx
RUN mise install "pipx:fastmcp@latest"
RUN mise cache clean

COPY docker/ /
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
